{
  "opencollection": "1.0.0",
  "info": {
    "name": "Checkr Account Screenings API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Screenings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve an SSN trace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.checkr.com/v1/reports/:report_id/ssn_trace/:id",
            "params": [
              {
                "name": "report_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Retrieve an SSN trace"
        },
        {
